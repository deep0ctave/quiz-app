map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    server_tokens off;

    # The real client address. X-Forwarded-For is believed only when it comes from a proxy in
    # TRUSTED_PROXY_CIDR (e.g. the cloud load balancer or ingress); otherwise the connection's own
    # address is used, so clients cannot pretend to be someone else.
    set_real_ip_from ${TRUSTED_PROXY_CIDR};
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;
    # API requests are small JSON documents.
    client_max_body_size 64k;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
    gzip_min_length 512;

    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy same-origin always;
    # Only this site's own scripts, styles and API may be used. HSTS belongs on the HTTPS
    # entry point (load balancer or ingress), not here.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ws: wss:; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

    location /api/ {
        proxy_pass ${API_UPSTREAM}/;
        # nginx adds these to every response; drop the backend's copies so they are not sent twice.
        proxy_hide_header X-Content-Type-Options;
        proxy_hide_header X-Frame-Options;
        proxy_set_header Host $host;
        # Replace (not append to) whatever the client sent, so the backend sees one trusted address.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 3600s;
    }

    location /assets/ {
        expires 1y;
    }

    location / {
        try_files $uri /index.html;
        expires epoch;
    }
}
