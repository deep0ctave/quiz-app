# Copy to .env to override the defaults used by docker-compose.yml
DB_NAME=quiz
DB_USERNAME=quiz
DB_PASSWORD=quiz
DB_PORT=5432
BACKEND_PORT=8080
WEB_PORT=3000

# Signs login tokens. Use a long random value (e.g. openssl rand -base64 48) outside local dev.
JWT_SECRET=local-dev-secret-change-me-0123456789abcdef

# First admin account, created on startup if this mobile number is not registered yet.
BOOTSTRAP_ADMIN_NAME=Admin
BOOTSTRAP_ADMIN_MOBILE=9999999999
BOOTSTRAP_ADMIN_PIN=123456

# Days of daily database dumps to keep in the "backups" volume.
BACKUP_KEEP_DAYS=7
